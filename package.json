{
  "name": "ai-agent-workspace",
  "version": "1.0.0",
  "description": "Production Agent Gateway with OpenClaw Skills and Databricks Llama 3.3 70B Integration",
  "main": "cli/index.ts",
  "scripts": {
    "build": "tsc",
    "start:gateway": "ts-node gateway/server.ts",
    "cli": "ts-node cli/index.ts",
    "install:skills": "node -e 'require(\"./tools/skills.ts\")' || true"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "openai": "^4.33.0",
    "quickjs-wasi": "^3.6.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.4.0",
    "playground:dev": "pnpm run --filter=playground dev",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "lint:fix": "npm run lint -- --fix",
    "build": "pnpm run -r build",
    "test": "pnpm run -r test",
    "typecheck": "pnpm run -r typecheck",
    "prepare": "husky"
  "lint-staged": {},
    "typecheck": "pnpm run -r typecheck"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint --edit $1"
    }
  },
  "engines": {
    "node": "20.15.1",
    "pnpm": "9.4.0"
    "@blitz/eslint-plugin": "0.1.0",
    "@commitlint/config-conventional": "^19.2.2",
    "commitlint": "^19.3.0",
    "husky": "^9.0.11",
    "is-ci": "^3.0.1",
    "prettier": "^3.3.2",
    "vitest": "^2.0.1"
  "resolutions": {
    "@typescript-eslint/utils": "^8.0.0-alpha.30"
  }
}
