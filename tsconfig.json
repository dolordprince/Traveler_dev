{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": ["app/**/*"],
  "exclude": [
    "node_modules",
    "packages",
    "frontend",
    "gateway",
    "tools",
    "config",
    "dist",
    "build",
    "load-context.ts",
    "vite.config.ts",
    "uno.config.ts"
  ]
}
