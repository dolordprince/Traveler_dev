{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": []
  },
  "include": [
    "app/**/*",
    "gateway/**/*",
    "tools/**/*",
    "config/**/*",
    "load-context.ts"
  ],
  "exclude": [
    "node_modules",
    "packages",
    "frontend",
    "dist",
    "build"
  ]
}
